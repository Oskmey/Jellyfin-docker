# Copy this file to .env and update the values.
# The setup script can create .env for you: ./scripts/setup.sh

# Base path for persistent data.
# Relative paths are resolved from the repository root.
COMMON_PATH=./data

# Container runtime settings
TZ=Europe/Stockholm
PUID=1000
PGID=1000
JELLYFIN_RENDER_GID=109

# Host interface binding.
# Use 0.0.0.0 for LAN access, or 127.0.0.1 for localhost-only testing.
BIND_IP=0.0.0.0

# Public nginx port on the host
NGINX_PORT=8090

# Browser-facing base URL for Homarr behind nginx.
# Replace localhost with the host or DNS name used on your LAN.
HOMARR_BASE_URL=http://localhost:8090

# Generated automatically by scripts/setup.sh. Keep both values secret.
# HOMARR_SECRET_ENCRYPTION_KEY must be exactly 64 hexadecimal characters.
# The sentinel values keep Compose's static config check usable; setup replaces them.
HOMARR_SECRET_ENCRYPTION_KEY=GENERATE_WITH_SETUP
GLUETUN_CONTROL_API_KEY=GENERATE_WITH_SETUP

# Public Seerr port on the host (direct, not proxied by nginx)
JELLYSEERR_PORT=5055

# Docker JSON log rotation defaults
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# Public Seerr URL used by the Homarr dashboard card.
# Replace localhost with the host or DNS name your browser uses to reach the stack.
JELLYSEERR_EXTERNAL_URL=http://localhost:5055

# Optional VPN defaults
SERVER_COUNTRIES=Sweden

# Required Mullvad WireGuard settings
WIREGUARD_ADDRESSES=
WIREGUARD_PRIVATE_KEY=
WIREGUARD_PUBLIC_KEY=
WIREGUARD_ENDPOINT=
WIREGUARD_ALLOWED_IPS=0.0.0.0/0
